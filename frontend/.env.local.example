# Copy to .env.local (git-ignored) and fill in with the addresses `npm run contracts:deploy:amoy`
# printed. .env.local is never committed - see NFR-03.

# Read-only RPC endpoint used for public views (tally, results) when no wallet is connected -
# this is what lets an observer check results without installing MetaMask (FR-12, increment D).
NEXT_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology/

NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_VOTER_REGISTRY_ADDRESS=
NEXT_PUBLIC_ELECTION_BALLOT_ADDRESS=
