# Copy to frontend/.env.local and fill in.   cp frontend/.env.local.example frontend/.env.local
# NEVER commit frontend/.env.local (it is git-ignored). Restart the server after editing it.
# Values below are set up for a LOCAL Hardhat chain. The Polygon Amoy values are in the comments.

# ===================== Public settings (shipped to the browser) =====================

# Address of the deployed ElectionFactory, printed by the deploy script:
#   local: npm run contracts:deploy:local      Amoy: npm run contracts:deploy:amoy
NEXT_PUBLIC_ELECTION_FACTORY_ADDRESS=0x...

# 31337 = local Hardhat node, 80002 = Polygon Amoy testnet
NEXT_PUBLIC_CHAIN_ID=31337

# How the app reads the chain.
#   local: http://127.0.0.1:8545
#   Amoy:  your provider URL, e.g. https://polygon-amoy.g.alchemy.com/v2/<your-api-key>
#          (Polygon's free public Amoy endpoint is shut down. This value is visible in the
#          browser, so restrict the key to your domain in the provider's dashboard.)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Optional block explorer for receipt links. Defaults by chain id.
# NEXT_PUBLIC_EXPLORER_URL=https://amoy.polygonscan.com

# The PUBLIC address of the server wallet (the wallet behind RELAYER_PRIVATE_KEY). It creates and
# runs every election made on this site, so this is the address to list here. Sign in as the owner
# and open "Accounts" to see it, or take it from MetaMask. It is an address, not a key.
# REQUIRED on any public network (without it the relayer and the public election list refuse to
# run). On the local chain (31337) leaving it empty allows everything, which suits development.
# NEXT_PUBLIC_ORGANISER_WALLETS=0xAddressOfYourRelayerWallet

# Only used by the old single-election demo page (/demo)
NEXT_PUBLIC_VOTER_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000001
NEXT_PUBLIC_ELECTION_BALLOT_ADDRESS=0x0000000000000000000000000000000000000002

# ---- Server-only secrets (never prefix these with NEXT_PUBLIC_, never commit this file) ----
# A DEDICATED throwaway wallet that pays gas for voters. Fund it with a little test POL; it is
# the only wallet that needs funding. Never reuse a personal wallet here.
RELAYER_PRIVATE_KEY=0x...

# ---- Sign-in (who may create elections) ----
# One owner account, set here. The owner opens /login, then "Accounts", and creates a username and
# password for each person who runs elections. There is no public sign-up. Password: 12+ characters.
OWNER_USERNAME=owner
OWNER_PASSWORD=

# Long random string (32+ chars). Anyone holding it can recompute every invite code, so treat it
# like a password. Changing it later invalidates invitations already sent. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVITE_SECRET=

# How invite links reach voters:
#   email  - send them with Resend (needs RESEND_API_KEY and EMAIL_FROM below)
#   links  - no email; the admin gets the links to hand out (copy / CSV)
INVITE_DELIVERY=email
RESEND_API_KEY=
EMAIL_FROM="VeraTally <voting@your-verified-domain.com>"

# Public address of the site, used inside invite emails. Optional; defaults to the request's own origin.
# PUBLIC_BASE_URL=https://veratally.example.com
