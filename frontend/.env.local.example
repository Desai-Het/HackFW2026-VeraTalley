# Copy to frontend/.env.local and fill in.   cp frontend/.env.local.example frontend/.env.local
# NEVER commit frontend/.env.local (it is git-ignored). Restart the server after editing it.
# Values below are set up for a LOCAL Hardhat chain. The Polygon Amoy values are in the comments.

# ===================== Public settings (shipped to the browser) =====================

# Address of the deployed ElectionFactory, printed by the deploy script:
#   local: npm run contracts:deploy:local      Amoy: npm run contracts:deploy:amoy
NEXT_PUBLIC_ELECTION_FACTORY_ADDRESS=0x...

# 31337 = local Hardhat node, 80002 = Polygon Amoy testnet
NEXT_PUBLIC_CHAIN_ID=31337

# How the app reads the chain.
#   local: http://127.0.0.1:8545
#   Amoy:  your provider URL, e.g. https://polygon-amoy.g.alchemy.com/v2/<your-api-key>
#          (Polygon's free public Amoy endpoint is shut down. This value is visible in the
#          browser, so restrict the key to your domain in the provider's dashboard.)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Optional block explorer for receipt links. Defaults by chain id.
# NEXT_PUBLIC_EXPLORER_URL=https://amoy.polygonscan.com

# The PUBLIC address of the server wallet (the wallet behind RELAYER_PRIVATE_KEY). It creates and
# runs every election made on this site, so this is the address to list here. Sign in as the owner
# and open "Accounts" to see it, or take it from MetaMask. It is an address, not a key.
# REQUIRED on any public network (without it the relayer and the public election list refuse to
# run). On the local chain (31337) leaving it empty allows everything, which suits development.
# NEXT_PUBLIC_ORGANISER_WALLETS=0xAddressOfYourRelayerWallet

# ===================== Public settings (shipped to the browser) =====================

# Address of the deployed ElectionFactory, printed by the deploy script:
#   local: npm run contracts:deploy:local      Amoy: npm run contracts:deploy:amoy
NEXT_PUBLIC_ELECTION_FACTORY_ADDRESS=0x...

# 31337 = local Hardhat node, 80002 = Polygon Amoy testnet
NEXT_PUBLIC_CHAIN_ID=31337

# How the app reads the chain.
#   local: http://127.0.0.1:8545
#   Amoy:  your provider URL, e.g. https://polygon-amoy.g.alchemy.com/v2/<your-api-key>
#          (Polygon's free public Amoy endpoint is shut down. This value is visible in the
#          browser, so restrict the key to your domain in the provider's dashboard.)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Optional block explorer for receipt links. Defaults by chain id.
# NEXT_PUBLIC_EXPLORER_URL=https://amoy.polygonscan.com

# Wallet address(es) allowed to run elections on this site, comma-separated. These are PUBLIC
# addresses (the ones MetaMask shows), not keys. Only these wallets can use the gasless relayer,
# send invitations and manage registrations, and elections made by other wallets are hidden.
# REQUIRED on any public network (without it those features refuse to run). On the local chain
# (31337) leaving it empty allows every wallet, which is convenient for development.
# NEXT_PUBLIC_ORGANISER_WALLETS=0xYourAdminWallet,0xAnotherAdmin

# Only used by the old single-election demo page (/demo). Safe to leave as is.
NEXT_PUBLIC_VOTER_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000001
NEXT_PUBLIC_ELECTION_BALLOT_ADDRESS=0x0000000000000000000000000000000000000002

# ===================== Server-only secrets =====================
# Never prefix these with NEXT_PUBLIC_. On a host, put them in its environment settings.

# A DEDICATED throwaway wallet that pays the network fee for voters. Fund it with a little test
# POL; it is the only wallet voters depend on. Must differ from your organiser wallet.
#   local: use "Account #1" printed by the hardhat node (a public test key).
RELAYER_PRIVATE_KEY=0x...

# ---- Sign-in (who may create elections) ----
# One owner account, set here. The owner opens /login, then "Accounts", and creates a username and
# password for each person who runs elections. There is no public sign-up. Password: 12+ characters.
OWNER_USERNAME=owner
OWNER_PASSWORD=

# Long random string (32+ chars). Anyone holding it can recompute every invite code, so treat it
# like a password. Changing it later invalidates invitations already sent. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVITE_SECRET=

# How invite links reach voters:
#   links - no email; the organiser gets the links to hand out (copy / CSV). Best for local tests.
#   email - send them with Resend (needs RESEND_API_KEY and EMAIL_FROM below)
INVITE_DELIVERY=links
RESEND_API_KEY=
EMAIL_FROM="VeraTalley <voting@your-verified-domain.com>"

# ===================== Hosting (set these once the site is public) =====================

# The exact public address of the site, no trailing slash. Used inside invite emails and to make
# sure signed organiser requests are only accepted for this site. Set it in production.
# PUBLIC_BASE_URL=https://veratalley.example.com

# How many reverse proxies sit in front of the app (Render, Railway, Fly, nginx, Cloudflare...).
# Used to find the real visitor address for rate limiting. 0 = none (local), 1 = typical host.
# Setting this too low or too high weakens rate limiting.
# TRUSTED_PROXY_HOPS=1

# Where registrations (people who sign up through the QR code) are saved. Must be a folder that
# survives restarts and redeploys: on Render/Railway/Fly attach a persistent disk and put its
# path here, e.g. /data. If you leave it out, ".data" inside the app folder is used (fine on your
# own computer or a VPS, but it is wiped on hosts without a persistent disk).
# DATA_DIR=/data
