# Copy to .env.local (git-ignored) and fill in with the values `npm run contracts:deploy:local`
# or `npm run contracts:deploy:amoy` printed. .env.local is never committed - see NFR-03.

# The demo election shown on the home page.
NEXT_PUBLIC_VOTER_REGISTRY_ADDRESS=
NEXT_PUBLIC_ELECTION_BALLOT_ADDRESS=

# The election factory: the Create / All elections pages read every election from it.
NEXT_PUBLIC_ELECTION_FACTORY_ADDRESS=

# Chain the app talks to (31337 = local Hardhat node, 80002 = Polygon Amoy) and the read-only
# RPC endpoint used for public views, so observers need no wallet (FR-12).
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=

# thirdweb client ID (free, from thirdweb.com/dashboard). When set, people sign in with email or
# Google and get a wallet automatically, with MetaMask still offered as an option. Leave it empty
# to keep the MetaMask-only flow. A client ID is public by design - it is not a secret key.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=
