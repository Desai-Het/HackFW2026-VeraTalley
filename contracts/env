# Copy to contracts/.env and fill in. NEVER commit contracts/.env.

# RPC URL for Polygon Amoy (chain 80002) from a provider such as Alchemy, QuickNode or dRPC.
# It must contain "polygon-amoy". Polygon's free public endpoint has been shut down.
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/alch_AtrGBcgSXZwiwlII-Y7EK

# Private key of a THROWAWAY wallet funded with Amoy test POL, with the 0x in front.
# This wallet deploys the contracts and is the admin of the elections it creates.
# Never use a real or mainnet-funded key.
PRIVATE_KEY=0x6504b7229d80596c377f0e85439b5f70b47d91364be806c4bec24c87a68feda8

# Optional. The deploy script deploys only the ElectionFactory on Amoy (elections are created
# from the app). To also create a demo election there, set CREATE_DEMO_ELECTION=true and list
# the wallets that may vote, comma-separated, in DEMO_VOTER_ADDRESSES.
CREATE_DEMO_ELECTION=false
DEMO_VOTER_ADDRESSES=0x953ae9F8aF0fC8e73EC414049dEd97542F7e5a3D

# Optional. Only for verifying source code on Polygonscan (an Etherscan.io API key).
ETHERSCAN_API_KEY=


