# Copy to contracts/.env and fill in.   cp contracts/.env.example contracts/.env
# NEVER commit contracts/.env (it is git-ignored). Only needed to deploy to Polygon Amoy;
# local development and the test suite need none of this.

# RPC URL for Polygon Amoy (chain 80002) from a provider such as Alchemy, QuickNode or dRPC.
# It must contain "polygon-amoy". Polygon's free public endpoint has been shut down.
# Example: https://polygon-amoy.g.alchemy.com/v2/<your-api-key>
AMOY_RPC_URL=

# Private key of a THROWAWAY wallet funded with Amoy test POL (from a faucet), with the 0x in
# front. This wallet only deploys the factory. Never use a real or mainnet-funded key.
PRIVATE_KEY=

# Optional. The deploy script deploys only the ElectionFactory on Amoy (elections are created
# from the app). To also create a demo election there, set CREATE_DEMO_ELECTION=true and list
# the wallets that may vote, comma-separated, in DEMO_VOTER_ADDRESSES.
CREATE_DEMO_ELECTION=
DEMO_VOTER_ADDRESSES=

# Optional. Only for verifying source code on Polygonscan (an Etherscan.io API key).
ETHERSCAN_API_KEY=
