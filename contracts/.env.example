# Copy this file to .env and fill in real values. Never commit .env - it's git-ignored.

# Polygon Amoy testnet RPC endpoint. The public one works for light use; swap in an
# Alchemy/Infura Amoy URL if you hit rate limits.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology/

# Deployer private key, funded with Amoy test POL from a faucet. This account becomes the
# admin of whatever it deploys (VoterRegistry + ElectionBallot) - see CR-02: it has no power
# over any election it didn't deploy. NEVER use a real/mainnet-funded key here.
PRIVATE_KEY=

# Required for an Amoy deploy: comma-separated wallet addresses to register as voters, e.g.
# the team's demo wallets. The deploy script refuses to run on Amoy without it, since an
# election with nobody registered can't be voted in. (Local deploys register test accounts.)
DEMO_VOTER_ADDRESSES=

# Optional: for `npx hardhat verify` (CR-05). An Etherscan.io API key - Etherscan's V2 API
# covers Polygon Amoy with one key.
ETHERSCAN_API_KEY=
