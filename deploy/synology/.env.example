# Copy to deploy/synology/.env on the NAS. NEVER commit .env. Keep it readable only by you.

# --- Built into the website (changing these needs a rebuild: Project -> Build) ---
NEXT_PUBLIC_ELECTION_FACTORY_ADDRESS=0x...
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/<your-api-key>
# NEXT_PUBLIC_EXPLORER_URL=https://amoy.polygonscan.com
# Public wallet address(es) of your organiser wallet(s), comma-separated. Required on Amoy.
NEXT_PUBLIC_ORGANISER_WALLETS=0x...

# --- Secrets (read when the container starts) ---
RELAYER_PRIVATE_KEY=0x...
# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVITE_SECRET=
INVITE_DELIVERY=links
RESEND_API_KEY=
EMAIL_FROM="VeraTalley <voting@your-verified-domain.com>"

# --- Hosting ---
PUBLIC_BASE_URL=https://vote.yourdomain.com
# 1 = only the Cloudflare tunnel sits in front of the app. Use 2 if you add another proxy.
TRUSTED_PROXY_HOPS=1

# --- Synology ---
# Token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> Docker
CLOUDFLARE_TUNNEL_TOKEN=
# Your NAS user's numbers: SSH in and run `id <username>`.
PUID=1026
PGID=100
# Folder on the NAS for registrations. Create it first.
DATA_HOST_PATH=/volume1/docker/veratalley/data
